  "kompetensi": {
    "kd": [
      {
        "kode": "3.5",
        "teks": "Memahami fungsi sosial, struktur teks dan unsur kebahasaan dari teks naratif sederhana tentang jenis dan warna, tema الأدوات المدرسية, tindak tutur menunjuk peralatan sekolah dengan susunan الضمير المتصل."
      },
      {
        "kode": "3.6",
        "teks": "Menganalisis gagasan dari teks naratif sederhana tentang jenis dan warna, tema الأدوات المدرسية, dengan memperhatikan bentuk, makna, dan fungsi الضمير المتصل."
      },
      {
        "kode": "4.5",
        "teks": "Mendemonstrasikan tindak tutur menunjuk peralatan sekolah dengan susunan الضمير المتصل, lisan maupun tulisan."
      },
      {
        "kode": "4.6",
        "teks": "Menyajikan hasil analisis gagasan dari teks naratif sederhana tentang jenis dan warna, tema الأدوات المدرسية, dengan memperhatikan الضمير المتصل."
      }
    ]
  },

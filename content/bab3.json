  "grammar": [
    {
      "id": "dhamir_muttashil",
      "title": "Isim Dhamir Muttashil (الضَّمِيْرُ الْمُتَّصِلُ)",
      "summary": "Kata ganti yang menempel di akhir kata benda untuk menunjukkan kepemilikan.",
      "table_example_base": "بَاب",
      "rows": [
        {
          "pronoun": "هُوَ",
          "suffix": "ـهُ",
          "result": "بَابُهُ",
          "id_meaning": "pintunya (lk)"
        },
        {
          "pronoun": "هِيَ",
          "suffix": "ـهَا",
          "result": "بَابُهَا",
          "id_meaning": "pintunya (pr)"
        },
        {
          "pronoun": "أَنْتَ",
          "suffix": "ـكَ",
          "result": "بَابُكَ",
          "id_meaning": "pintumu (lk)"
        },
        {
          "pronoun": "أَنْتِ",
          "suffix": "ـكِ",
          "result": "بَابُكِ",
          "id_meaning": "pintumu (pr)"
        },
        {
          "pronoun": "أَنَا",
          "suffix": "ـيْ",
          "result": "بَابِيْ",
          "id_meaning": "pintuku"
        },
        {
          "pronoun": "نَحْنُ",
          "suffix": "ـنَا",
          "result": "بَابُنَا",
          "id_meaning": "pintu kami/kita"
        }
      ],
      "rules": [
        "Kata benda yang sudah diberi dhamir muttashil TIDAK boleh diawali ال. Salah: الْكُرْسِيُّهُ — Benar: كُرْسِيُّهُ.",
